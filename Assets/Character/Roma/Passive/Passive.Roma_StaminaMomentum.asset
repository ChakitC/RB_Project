  m_Script: {fileID: 11500000, guid: 977e63054233f2041b66a0125929398e, type: 3}
  m_Name: Passive.Roma_StaminaMomentum
  m_EditorClassIdentifier: 
  passiveId: passive.roma.stamina-momentum
  icon: {fileID: 21300000, guid: 00175ad6f08e47c43b0271b5facc92cb, type: 3}
  description: 'Perfect Dash restores 10 Stamina once per Dash. Convert each +1 Stamina
    Regen bonus into +4 Max Stamina. Below 70% Stamina, gain +0.5% Damage per 1%
    missing Stamina. Spending Stamina builds Momentum to 100. The next successful
    normal shot consumes 100 to activate Combat Surge for 5 seconds: +30% reload
    speed and 50% less aim movement penalty. Momentum cannot build during Combat
    Surge.'
  upgradeTree: {fileID: 11400000, guid: 5f8e5c302befde848b47775d8525b354, type: 2}
  recipe: {fileID: -729455128634228935}
  hudPrefab: {fileID: 4924810807773998140, guid: dd3cf635ef050a242be8002c2afd3bb1, type: 3}
  definitionId: f332ba5a200446b4594e61646b3144bf
