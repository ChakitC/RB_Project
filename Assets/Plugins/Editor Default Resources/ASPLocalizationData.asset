    - "\u63A5\u6536\u9670\u5F71\u884C\u70BA\uFF08Lambert\u6A21\u5F0F\uFF09"
    - "\u5F71\u6319\u52D5\uFF08Lambert\u30E2\u30FC\u30C9\uFF09"
  - propertyName: _LambertReceivedShadowColor
    translations:
    - Custom Received Shadow Color (Lambert)
    - "\u81EA\u8A02\u63A5\u6536\u9670\u5F71\u984F\u8272\uFF08Lambert\u6A21\u5F0F\uFF09"
    - "\u30AB\u30B9\u30BF\u30E0\u5F71\u30AB\u30E9\u30FC\uFF08Lambert\u30E2\u30FC\u30C9\uFF09"
  - propertyName: _UsePupilMask
    translations:
    - Mask MatCap Reflection By Pupil Mask
    - "\u4F7F\u7528\u77B3\u5B54\u906E\u7F69\u9650\u5236MatCap\u53CD\u5C04\u7BC4\u570D"
    - "\u77B3\u5B54\u30DE\u30B9\u30AF\u306B\u3088\u308BMatCap\u53CD\u5C04\u30DE\u30B9\u30AF"
  - propertyName: _GroupHighlightLayer1
    translations:
    - Highlights
    - "\u9AD8\u5149\u6548\u679C"
    - "\u30CF\u30A4\u30E9\u30A4\u30C8"
  - propertyName: _HighLightAlphaClip
    translations:
    - Is Highlight Texture Alpha Clip
    - "\u5C0D\u773C\u775B\u9AD8\u5149\u8CBC\u5716\u4F7F\u7528\u900F\u660E\u5EA6\u526A\u88C1"
    - "\u30CF\u30A4\u30E9\u30A4\u30C8\u30C6\u30AF\u30B9\u30C1\u30E3\u306E\u30A2\u30EB\u30D5\u30A1\u30AF\u30EA\u30C3\u30D7"
  - propertyName: _HighlightDarken
    translations:
    - Darken Emission along light direction
    - "\u6839\u64DA\u5149\u7167\u65B9\u5411\u8870\u6E1B\u9AD8\u5149\u5F37\u5EA6"
    - "\u5149\u65B9\u5411\u306B\u6CBF\u3063\u305F\u30A8\u30DF\u30C3\u30B7\u30E7\u30F3\u6E1B\u8870"
  - propertyName: _EyeHighlightMap1
    translations:
    - Top Highlight Map
    - "\u9AD8\u5149\u8CBC\u5716"
    - "\u30C8\u30C3\u30D7\u30CF\u30A4\u30E9\u30A4\u30C8\u30DE\u30C3\u30D7"
  - propertyName: _EyeHighlightRotateDegree
    translations:
    - Rotate Degree Along Half Vector
    - "\u6839\u64DA\u5149\u7167\u65B9\u5411\u7684\u9AD8\u5149\u6548\u679C\u65CB\u8F49\u89D2\u5EA6"
    - "\u30CF\u30FC\u30D5\u30D9\u30AF\u30C8\u30EB\u306B\u6CBF\u3063\u305F\u56DE\u8EE2\u89D2\u5EA6"
  - propertyName: _EyeHighlightColor
    translations:
    - Top Highlight Color Tint
    - "\u773C\u775B\u9AD8\u5149\u984F\u8272"
    - "\u30C8\u30C3\u30D7\u30CF\u30A4\u30E9\u30A4\u30C8\u30AB\u30E9\u30FC"
  tooltipEntries:
  - propertyName: _style
    translations:
    - 
    - "\u6E32\u67D3\u7684\u6750\u8CEA\u98A8\u683C\uFF0C\u8ACB\u53C3\u7167\u6587\u4EF6\u8A73\u7D30\u8AAA\u660E"
    - "\u30DE\u30C6\u30EA\u30A2\u30EB\u306E\u63CF\u753B\u30B9\u30BF\u30A4\u30EB\u3002\u8A73\u7D30\u306F\u30C9\u30AD\u30E5\u30E1\u30F3\u30C8\u3092\u53C2\u7167\u3057\u3066\u304F\u3060\u3055\u3044"
  - propertyName: _Group0
    translations:
    - 
    - 
    - 
  - propertyName: _AlphaClip
    translations:
    - '"Controls whether to enable Alpha Test. Pixels with a texture alpha value
      (or Dithering) lower than the threshold will be discarded."'
    - "\"\u63A7\u5236\u662F\u5426\u958B\u555FAlpha Test\u3002\u8CBC\u5716alpha\u503C(\u6216Dithering)\u4F4E\u65BC\u7B4F\u503C\u7684\u50CF\u7D20\u6703\u88AB\u5243\u9664\u3002\""
    - "\"\u30A2\u30EB\u30D5\u30A1\u30C6\u30B9\u30C8\u3092\u6709\u52B9\u306B\u3059\u308B\u304B\u3069\u3046\u304B\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u30C6\u30AF\u30B9\u30C1\u30E3\u306E\u30A2\u30EB\u30D5\u30A1\u5024\uFF08\u307E\u305F\u306F\u30C7\u30A3\u30B6\u30EA\u30F3\u30B0\uFF09\u304C\u3057\u304D\u3044\u5024\u3088\u308A\u3082\u4F4E\u3044\u30D4\u30AF\u30BB\u30EB\u306F\u7834\u68C4\u3055\u308C\u307E\u3059\u3002\""
  - propertyName: _Cutoff
    translations:
    - '"The threshold for Alpha Clipping"'
    - "\"Alpha Clipping\u7684\u7B4F\u503C\""
    - "\"\u30A2\u30EB\u30D5\u30A1\u30AF\u30EA\u30C3\u30D4\u30F3\u30B0\u306E\u3057\u304D\u3044\u5024\""
  - propertyName: _ClipMap
    translations:
    - '"Mask for alpha clip. The R channel of the sampled texture will treat as the
      current alpha."'
    - "\"\u7528\u65BCAlpha Clip\u7684\u8CBC\u5716\uFF0C\u63A1\u6A23\u8A72\u8CBC\u5716\u7684R
      channel\u4F5C\u70BA\u7576\u4E0B\u7684alpha\""
    - "\"\u30A2\u30EB\u30D5\u30A1\u30AF\u30EA\u30C3\u30D7\u7528\u306E\u30DE\u30B9\u30AF\u3002\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3055\u308C\u305F\u30C6\u30AF\u30B9\u30C1\u30E3\u306ER\u30C1\u30E3\u30F3\u30CD\u30EB\u306F\u3001\u73FE\u5728\u306E\u30A2\u30EB\u30D5\u30A1\u3068\u3057\u3066\u6271\u308F\u308C\u307E\u3059\u3002\""
  - propertyName: _AlphaClipUVCtrl
    translations:
    - '"Select which UV channel to use for sampling the Clip Map."'
    - "\"\u9078\u64C7\u7528\u65BC\u63A1\u6A23\u526A\u5207\u8CBC\u5716\u7684UV\u901A\u9053\u3002\""
    - "\"\u30AF\u30EA\u30C3\u30D7\u30DE\u30C3\u30D7\u306E\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u306B\u4F7F\u7528\u3059\u308BUV\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u9078\u629E\u3057\u307E\u3059\u3002\""
  - propertyName: _Dithering
    translations:
    - '"The strength of the Dither pseudo-transparency effect. Alpha Clipping must
      be enabled before using this."'
    - "\"Dither\u507D\u534A\u900F\u660E\u6548\u679C\u7684\u5F37\u5EA6\uFF0C\u4F7F\u7528\u524D\u9700\u958B\u555FAlpha
      Clipping\""
    - "\"\u30C7\u30A3\u30B6\u7591\u4F3C\u900F\u660E\u52B9\u679C\u306E\u5F37\u5EA6\u3002\u3053\u308C\u3092\u4F7F\u7528\u3059\u308B\u524D\u306B\u3001\u30A2\u30EB\u30D5\u30A1\u30AF\u30EA\u30C3\u30D4\u30F3\u30B0\u3092\u6709\u52B9\u306B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\""
  - propertyName: _DitherTexelSize
    translations:
    - '"The size of the dither pattern in screen pixel unit."'
    - "\"Dither\u7684\u6392\u5217\u50CF\u7D20\u5927\u5C0F\uFF0C\u507D\u534A\u900F\u660E\u7684\u584A\u72C0\u6703\u6703\u96A8\u50CF\u7D20\u5927\u5C0F\u8B8A\u5316\u3002\""
    - "\"\u30C7\u30A3\u30B6\u30D1\u30BF\u30FC\u30F3\u306E\u753B\u9762\u30D4\u30AF\u30BB\u30EB\u5358\u4F4D\u3067\u306E\u30B5\u30A4\u30BA\u3002\""
  - propertyName: _SurfaceType
    translations:
    - '"Surface type (transparent or opaque)"'
    - "\"\u8868\u9762\u985E\u578B(\u534A\u900F\u660E\u6216\u975E\u534A\u900F\u660E\u6750\u8CEA)\""
    - "\"\u30B5\u30FC\u30D5\u30A7\u30B9\u30BF\u30A4\u30D7\uFF08\u900F\u660E\u307E\u305F\u306F\u4E0D\u900F\u660E\uFF09\""
  - propertyName: _Cull
    translations:
    - '"The mesh face to be rendered (Front, Back, Both)"'
    - "\"\u6B32\u6E32\u67D3\u7684mesh face (Front, Back, Both)\""
    - "\"\u30EC\u30F3\u30C0\u30EA\u30F3\u30B0\u3055\u308C\u308B\u30E1\u30C3\u30B7\u30E5\u9762\uFF08\u524D\u9762\u3001\u80CC\u9762\u3001\u4E21\u65B9\uFF09\""
  - propertyName: _FOVShiftX
    translations:
    - '"Controls the effect of correcting the perspective projection FOV deformation.
      The default is 0 for no correction, and adjusting to 1 will approach orthographic
      projection."'
    - "\"\u63A7\u5236\u4FEE\u6B63\u900F\u8996\u6295\u5F71FOV\u8B8A\u5F62\u7684\u6548\u679C\uFF0C\u9810\u8A2D\u70BA0\u70BA\u4E0D\u4FEE\u6B63\uFF0C\u8ABF\u6574\u52301\u5247\u662F\u6703\u8DA8\u8FD1\u65BC\u6B63\u4EA4\u6295\u5F71\u3002\""
    - "\"\u30D1\u30FC\u30B9\u6295\u5F71FOV\u306E\u5909\u5F62\u3092\u4FEE\u6B63\u3059\u308B\u52B9\u679C\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u30C7\u30D5\u30A9\u30EB\u30C8\u306F\u4FEE\u6B63\u306A\u3057\u306E0\u3067\u30011\u306B\u8ABF\u6574\u3059\u308B\u3068\u6B63\u6295\u5F71\u306B\u8FD1\u3065\u304D\u307E\u3059\u3002\""
  - propertyName: _Group1
    translations:
    - 
    - 
    - 
  - propertyName: _SurfaceUVCtrl
    translations:
    - '"Select which UV channel to use for sampling surface textures (Albedo, Normal,
      ORM)."'
    - "\"\u9078\u64C7\u7528\u65BC\u63A1\u6A23\u8868\u9762\u8CBC\u5716\uFF08Albedo\u3001Normal\u3001ORM\uFF09\u7684UV\u901A\u9053\u3002\""
    - "\"\u8868\u9762\u30C6\u30AF\u30B9\u30C1\u30E3\uFF08\u30A2\u30EB\u30D9\u30C9\u3001\u30CE\u30FC\u30DE\u30EB\u3001ORM\uFF09\u306E\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u306B\u4F7F\u7528\u3059\u308BUV\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u9078\u629E\u3057\u307E\u3059\u3002\""
  - propertyName: _BaseMap
    translations:
    - '"Albedo map"'
    - "\"albedo\u8CBC\u5716\""
    - "\"\u30A2\u30EB\u30D9\u30C9\u30DE\u30C3\u30D7\""
  - propertyName: _BaseColor
    translations:
    - '"Base color"'
    - "\"\u57FA\u790E\u984F\u8272\""
    - "\"\u30D9\u30FC\u30B9\u30AB\u30E9\u30FC\""
  - propertyName: _BumpMap
    translations:
    - '"Normal map"'
    - "\"\u6CD5\u7DDA\u8CBC\u5716\""
    - "\"\u6CD5\u7DDA\u30DE\u30C3\u30D7\""
  - propertyName: _BumpScale
    translations:
    - '"Controls the strength of the normal map, with a range of 0 to 1"'
    - "\"\u63A7\u5236\u6CD5\u7DDA\u8CBC\u5716\u7684\u5F71\u97FF\u5F37\u5EA6\uFF0C\u7BC4\u570D\u662F0\u52301\""
    - "\"\u6CD5\u7DDA\u30DE\u30C3\u30D7\u306E\u5F37\u3055\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _OSMTexture
    translations:
    - '"PBR Map, R Channel - Occlusion. G Channel - Smoothness (1 - Roughness). B
      Channel - Metallic"'
    - "\"PBR\u6750\u8CEA\u8CBC\u5716 - R\u901A\u9053\u70BAOcclusion\uFF0CG\u901A\u9053\u70BA\u5149\u6ED1\u5EA6(1
      - Roughness)\uFF0CB\u901A\u9053\u70BAMetallic\u3002\""
    - "\"PBR\u30DE\u30C6\u30EA\u30A2\u30EB\u30C6\u30AF\u30B9\u30C1\u30E3-R\u30C1\u30E3\u30F3\u30CD\u30EB\u306F\u30AA\u30AF\u30EB\u30FC\u30B8\u30E7\u30F3\u3001G\u30C1\u30E3\u30F3\u30CD\u30EB\u306F\u6ED1\u3089\u304B\u3055\uFF081-\u7C97\u3055\uFF09\u3001B\u30C1\u30E3\u30F3\u30CD\u30EB\u306F\u30E1\u30BF\u30EA\u30C3\u30AF\u3067\u3059\u3002\""
  - propertyName: _PBRMetallic
    translations:
    - '"Control the metalness"'
    - "\"\u91D1\u5C6C\u5EA6\uFF0C\u7576OSM\u8CBC\u5716\u4E0D\u5B58\u5728\u6642\u53EF\u4EE5\u7528\u6B64\u6578\u8ABF\u6574\u6574\u500B\u6750\u8CEA\u7684\u91D1\u5C6C\u5EA6\""
    - "\"\u91D1\u5C5E\u5EA6\u3002OSM\u30C6\u30AF\u30B9\u30C1\u30E3\u304C\u5B58\u5728\u3057\u306A\u3044\u5834\u5408\u306F\u3001\u3053\u306E\u6570\u5024\u3092\u4F7F\u7528\u3057\u3066\u30DE\u30C6\u30EA\u30A2\u30EB\u5168\u4F53\u306E\u91D1\u5C5E\u5EA6\u3092\u8ABF\u6574\u3067\u304D\u307E\u3059\u3002\""
  - propertyName: _PBRSmoothness
    translations:
    - '"Smoothness, i.e. (1 - roughness) in PBR of other non-Unity renderers"'
    - "\"\u5149\u6ED1\u5EA6\uFF0C\u5373\u5176\u4ED6\u975EUnity\u6E32\u67D3\u5668\u4E2DPBR\u7684(1
      - roughness)\u3002\""
    - "\"\u6ED1\u3089\u304B\u3055\u3001\u3064\u307E\u308A\u4ED6\u306E\u975EUnity\u30EC\u30F3\u30C0\u30E9\u30FC\u306EPBR\u306B\u304A\u3051\u308B\uFF081-\u7C97\u3055\uFF09\u3002\""
  - propertyName: _PBROcclusionStrength
    translations:
    - '"Controls the strength when sampling the R channel of the OSM map, with a
      range of 0 to 1"'
    - "\"\u63A7\u5236\u63A1\u6A23OSM\u8CBC\u5716R\u901A\u9053\u6642\u7684\u5F37\u5EA6\uFF0C\u7BC4\u570D\u662F0\u52301\""
    - "\"OSM\u30DE\u30C3\u30D7\u306ER\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3059\u308B\u969B\u306E\u5F37\u5EA6\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _RampOcclusionMap
    translations:
    - '"The effect is the same as a regular occlusion map, but the occlusion color
      will be the leftmost color of the ramp map"'
    - "\"\u6548\u679C\u7B49\u540C\u4E00\u822C\u7684Occlusion Map\uFF0C\u4F46\u662F\u906E\u853D\u984F\u8272\u6703\u662FRamp
      Lighting Map\u7684\u6700\u5DE6\u7AEF\u984F\u8272\""
    - "\"\u52B9\u679C\u306F\u901A\u5E38\u306E\u30AA\u30AF\u30EB\u30FC\u30B8\u30E7\u30F3\u30DE\u30C3\u30D7\u3068\u540C\u3058\u3067\u3059\u304C\u3001\u30AA\u30AF\u30EB\u30FC\u30B8\u30E7\u30F3\u30AB\u30E9\u30FC\u306F\u30E9\u30F3\u30D7\u30DE\u30C3\u30D7\u306E\u5DE6\u7AEF\u306E\u30AB\u30E9\u30FC\u306B\u306A\u308A\u307E\u3059\u3002\""
  - propertyName: _RampOcclusionStrength
    translations:
    - '"Controls the strength when sampling the R channel of the ramp occlusion map,
      with a range of 0 to 1"'
    - "\"\u63A7\u5236\u63A1\u6A23Ramp Occlusion Map\u7684R\u901A\u9053\u5F8C\u906E\u64CB\u7684\u5F37\u5EA6\uFF0C\u7BC4\u570D\u662F0\u52301\""
    - "\"\u30E9\u30F3\u30D7\u30AA\u30AF\u30EB\u30FC\u30B8\u30E7\u30F3\u30DE\u30C3\u30D7\u306ER\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3059\u308B\u969B\u306E\u5F37\u5EA6\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _EmissionToggle
    translations:
    - '"Whether to enable the emission effect"'
    - "\"\u662F\u5426\u958B\u555F\u81EA\u767C\u5149\u6548\u679C\""
    - "\"\u767A\u5149\u52B9\u679C\u3092\u6709\u52B9\u306B\u3059\u308B\u304B\u3069\u3046\u304B\""
  - propertyName: _EmissionMap
    translations:
    - '"Emission map"'
    - "\"\u81EA\u767C\u5149\u8CBC\u5716/\u984F\u8272\""
    - "\"\u767A\u5149\u30DE\u30C3\u30D7/\u30AB\u30E9\u30FC\""
  - propertyName: _EmissionColor
    translations:
    - '"Emission color"'
    - "\"\u81EA\u767C\u5149\u984F\u8272\""
    - "\"\u767A\u5149\u8272\""
  - propertyName: _Group5
    translations:
    - 
    - 
    - 
  - propertyName: _FaceShadowMap
    translations:
    - '"SDF-based face shadow threshold map"'
    - "\"\u57FA\u65BCSDF\u7684\u81C9\u90E8\u9670\u5F71\u7B4F\u503C\u8CBC\u5716\""
    - "\"SDF\u30D9\u30FC\u30B9\u306E\u30A2\u30CB\u30E1\u9854\u7528\u306E\u5F71\u3057\u304D\u3044\u5024\u30DE\u30C3\u30D7\""
  - propertyName: _FaceUVCtrl
    translations:
    - '"UV channel for face shadow map sampling"'
    - "\"\u81C9\u90E8\u9670\u5F71\u8CBC\u5716\u63A1\u6A23UV\u901A\u9053\""
    - "\"\u30A2\u30CB\u30E1\u9854\u7528\u306E\u5F71\u30C6\u30AF\u30B9\u30C1\u30E3\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0UV\u30C1\u30E3\u30CD\u30EB\""
  - propertyName: _FaceShadowMapPow
    translations:
    - '"Sensitivity of face shadow to lighting angle changes"'
    - "\"\u81C9\u90E8\u9670\u5F71\u5C0D\u65BC\u5149\u7167\u89D2\u5EA6\u8B8A\u5316\u7684\u654F\u611F\u5EA6\""
    - "\"\u5149\u306E\u89D2\u5EA6\u306E\u5909\u5316\u306B\u5BFE\u3059\u308B\u30A2\u30CB\u30E1\u9854\u7528\u306E\u5F71\u306E\u611F\u5EA6\""
  - propertyName: _FaceShadowSmoothness
    translations:
    - '"Shadow boundary softness"'
    - "\"\u9670\u5F71\u908A\u754C\u67D4\u548C\u5EA6\""
    - "\"\u30A2\u30CB\u30E1\u9854\u7528\u306E\u5F71\u306E\u5883\u754C\u306E\u6ED1\u3089\u304B\u3055\""
  - propertyName: _Group2
    translations:
    - 
    - 
    - 
  - propertyName: _WorkflowSpace
    translations:
    - '"Determines whether to use gamma workflow or linear workflow when calculating
      ramp lighting. For non-StylizePBR materials, either workflow can be used."'
    - "\"\u6C7A\u5B9A\u8A08\u7B97ramp lighting\u6642\u4F7F\u7528gamma workflow\u6216\u662Flinear
      workflow\u3002 \u5C0D\u65BC\u975EStylizePBR\u7684\u6750\u8CEA\u4F86\u8AAA\uFF0C\u4F7F\u7528\u4EFB\u610Fworkflow\u90FD\u53EF\u4EE5\u3002\""
    - "\"\u30E9\u30F3\u30D7\u7167\u660E\u3092\u8A08\u7B97\u3059\u308B\u969B\u306B\u3001\u30AC\u30F3\u30DE\u30EF\u30FC\u30AF\u30D5\u30ED\u30FC\u3068\u30EA\u30CB\u30A2\u30EF\u30FC\u30AF\u30D5\u30ED\u30FC\u306E\u3069\u3061\u3089\u3092\u4F7F\u7528\u3059\u308B\u304B\u3092\u6C7A\u5B9A\u3057\u307E\u3059\u3002StylizePBR\u4EE5\u5916\u306E\u30DE\u30C6\u30EA\u30A2\u30EB\u306E\u5834\u5408\u3001\u3069\u3061\u3089\u306E\u30EF\u30FC\u30AF\u30D5\u30ED\u30FC\u3082\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002\""
  - propertyName: _RampMap
    translations:
    - '"A gradient map that controls the brightness and color of the main light source
      on the material."'
    - "\"\u6F38\u8B8A\u5716\uFF0C\u63A7\u5236\u4E3B\u5149\u6E90\u5728\u6750\u8CEA\u4E0A\u7684\u5149\u7167\u660E\u6697\u8207\u984F\u8272\u3002\""
    - "\"\u30DE\u30C6\u30EA\u30A2\u30EB\u4E0A\u306E\u4E3B\u5149\u6E90\u306E\u660E\u308B\u3055\u3068\u8272\u3092\u5236\u5FA1\u3059\u308B\u30B0\u30E9\u30C7\u30FC\u30B7\u30E7\u30F3\u30DE\u30C3\u30D7\u3002\""
  - propertyName: _EnableSSSRamp
    translations:
    - '"Controls whether to sample an additional gradient map and overlay a layer
      of subsurface scattering effects."'
    - "\"\u63A7\u5236\u662F\u5426\u63A1\u6A23\u984D\u5916\u7684\u6F38\u8B8A\u5716\uFF0C\u4E26\u758A\u52A0\u4E00\u5C64\u6B21\u8868\u9762\u6563\u5C04\u6548\u679C\u3002\""
    - "\"\u8FFD\u52A0\u306E\u30B0\u30E9\u30C7\u30FC\u30B7\u30E7\u30F3\u30DE\u30C3\u30D7\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3057\u3001\u30B5\u30FC\u30D5\u30A7\u30B9\u4E0B\u306E\u6563\u4E71\u52B9\u679C\u306E\u30EC\u30A4\u30E4\u30FC\u3092\u91CD\u306D\u308B\u304B\u3069\u3046\u304B\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _SSSRampMap
    translations:
    - '"A gradient map used for subsurface scattering, the sampling logic is independent
      of lighting and uses the normal and view direction of the object."'
    - "\"\u6B21\u8868\u9762\u6563\u5C04\u7528\u7684\u6F38\u8B8A\u5716\uFF0C\u63A1\u6A23\u7684\u908F\u8F2F\u8207\u5149\u7167\u7121\u95DC\u800C\u662F\u4F7F\u7528\u7269\u9AD4\u7684\u6CD5\u7DDA\u8207\u8996\u89D2\u3002\""
    - "\"\u30B5\u30FC\u30D5\u30A7\u30B9\u4E0B\u306E\u6563\u4E71\u306B\u4F7F\u7528\u3055\u308C\u308B\u30B0\u30E9\u30C7\u30FC\u30B7\u30E7\u30F3\u30DE\u30C3\u30D7\u3002\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u30ED\u30B8\u30C3\u30AF\u306F\u7167\u660E\u3068\u306F\u7121\u95A2\u4FC2\u3067\u3001\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u306E\u6CD5\u7DDA\u3068\u8996\u7DDA\u65B9\u5411\u3092\u4F7F\u7528\u3057\u307E\u3059\u3002\""
  - propertyName: _ShadowColorMode
    translations:
    - '"Controls how the shadow color behave when receiving shadows from the ShadowMap."'
    - "\"\u63A7\u5236\u63A5\u6536ShadowMap\u7684\u9670\u5F71\u6642\uFF0C\u8A72\u5982\u4F55\u6DF7\u548C\u9670\u5F71\u7684\u984F\u8272\u3002\""
    - "\"ShadowMap\u304B\u3089\u5F71\u3092\u53D7\u3051\u53D6\u308B\u969B\u306E\u5F71\u306E\u8272\u52D5\u4F5C\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _ReceivedShadowColor
    translations:
    - '"Custom color used for received shadows"'
    - "\"\u81EA\u8A02\u7684\u63A5\u6536\u9670\u5F71\u984F\u8272\""
    - "\"\u53D7\u4FE1\u3057\u305F\u5F71\u306B\u4F7F\u7528\u3055\u308C\u308B\u30AB\u30B9\u30BF\u30E0\u30AB\u30E9\u30FC\""
  - propertyName: _PBRInfluenceDirectLighting
    translations:
    - '"Controls the blend between Ramp Lighting and direct diffuse from the standard
      PBR model, with a range of 0 to 1."'
    - "\"\u63A7\u5236\u76F4\u63A5\u5149\u7684Ramp Lighting\u8207\u6A19\u6E96PBR\u5149\u7167\u4E4B\u9593\u7684\u6DF7\u548C\u5EA6\uFF0C0\u7684\u8A71\u6703\u5B8C\u5168\u662FRamp
      Lighting\uFF0C1\u7684\u8A71\u5247\u662F\u6703\u5B8C\u5168\u662F\u6A19\u6E96PBR\""
    - "\"\u6A19\u6E96PBR\u30E2\u30C7\u30EB\u304B\u3089\u306E\u30E9\u30F3\u30D7\u7167\u660E\u3068\u76F4\u63A5\u62E1\u6563\u306E\u30D6\u30EC\u30F3\u30C9\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _BakeGISource
    translations:
    - '"Controls the environment indirect lighting received by the current pixel.
      If the scene lighting is baked, the source of indirect GI will be the spherical
      harmonic lighting information stored in the light probe. If there is no baking,
      the source of this spherical harmonic lighting will be the skybox."'
    - "\"\u63A7\u5236\u7576\u524D\u50CF\u7D20\u63A5\u6536\u7684\u74B0\u5883\u5149/\u9593\u63A5\u5149\u4F86\u6E90\""
    - "\"\u73FE\u5728\u306E\u30D4\u30AF\u30BB\u30EB\u304C\u53D7\u4FE1\u3059\u308B\u74B0\u5883\u9593\u63A5\u7167\u660E\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u30B7\u30FC\u30F3\u306E\u7167\u660E\u304C\u30D9\u30A4\u30AF\u3055\u308C\u3066\u3044\u308B\u5834\u5408\u3001\u9593\u63A5GI\u306E\u30BD\u30FC\u30B9\u306F\u3001\u30E9\u30A4\u30C8\u30D7\u30ED\u30FC\u30D6\u306B\u683C\u7D0D\u3055\u308C\u3066\u3044\u308B\u7403\u9762\u8ABF\u548C\u95A2\u6570\u7167\u660E\u60C5\u5831\u306B\u306A\u308A\u307E\u3059\u3002\u30D9\u30A4\u30AF\u304C\u306A\u3044\u5834\u5408\u3001\u3053\u306E\u7403\u9762\u8ABF\u548C\u95A2\u6570\u7167\u660E\u306E\u30BD\u30FC\u30B9\u306F\u30B9\u30AB\u30A4\u30DC\u30C3\u30AF\u30B9\u306B\u306A\u308A\u307E\u3059\u3002\""
  - propertyName: _OverrideGIColor
    translations:
    - '"A specified color to replace environment lighting."'
    - "\"\u4EE3\u66FF\u63A5\u6536\u5230\u7684\u74B0\u5883/\u9593\u63A5\u5149\u7684\u6307\u5B9A\u8272\""
    - "\"\u74B0\u5883\u5149\u3092\u7F6E\u304D\u63DB\u3048\u308B\u6307\u5B9A\u8272\u3002\""
  - propertyName: _FlattenAdditionalLighting
    translations:
    - '"Whether to flatten the lighting results from additional lights"'
    - "\"\u662F\u5426\u6241\u5E73\u5316\u9664\u4E86\u4E3B\u5149\u6E90\u5916\u7684\u5176\u4ED6\u5149\u6E90\u7684\u5149\u7167\u8A08\u7B97\u7D50\u679C\u3002\""
    - "\"\u8FFD\u52A0\u306E\u30E9\u30A4\u30C8\u304B\u3089\u306E\u7167\u660E\u7D50\u679C\u3092\u30D5\u30E9\u30C3\u30C8\u306B\u3059\u308B\u304B\u3069\u3046\u304B\""
  - propertyName: _EnvironmentReflections
    translations:
    - '"Whether or not to include indirect specular lighting from the PBR model in
      indirect GI. (In Unity, the reflection source will be the result of sampling
      a nearby reflection probe or the skybox if no reflection probe present)"'
    - "\"Indirect GI\u4E2D\u662F\u5426\u8981\u5305\u542BPBR\u6A21\u578B\u5167\u7684\u74B0\u5883\u53CD\u5C04(indirect
      specular lighting)\u3002\u5728Unity\u4E2D\u7684\u53CD\u5C04\u4F86\u6E90\u6703\u662F\u81E8\u8FD1reflection
      probe\u7684\u63A1\u6A23\u7D50\u679C\u6216\u662F\u5929\u7A7A\u76D2\u3002\""
    - "\"\u9593\u63A5GI\u306BPBR\u30E2\u30C7\u30EB\u304B\u3089\u306E\u9593\u63A5\u93E1\u9762\u53CD\u5C04\u5149\u3092\u542B\u3081\u308B\u304B\u3069\u3046\u304B\u3002\uFF08Unity\u3067\u306F\u3001\u53CD\u5C04\u30BD\u30FC\u30B9\u306F\u3001\u8FD1\u304F\u306E\u53CD\u5C04\u30D7\u30ED\u30FC\u30D6\u306E\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u7D50\u679C\u3001\u307E\u305F\u306F\u53CD\u5C04\u30D7\u30ED\u30FC\u30D6\u304C\u306A\u3044\u5834\u5408\u306F\u30B9\u30AB\u30A4\u30DC\u30C3\u30AF\u30B9\u306B\u306A\u308A\u307E\u3059\uFF09\""
  - propertyName: _Group3
    translations:
    - 
    - 
    - 
  - propertyName: _SpecularHighlights
    translations:
    - '"Enable specular highlights."'
    - "\"\u986F\u793A\u93E1\u9762\u53CD\u5C04\u9AD8\u5149\u3002\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u3092\u6709\u52B9\u306B\u3059\u308B\u3002\""
  - propertyName: _SpecularMaskMap
    translations:
    - '"A mask texture that controls the area where specular highlights are displayed.
      When the sampled value is 0, no specular highlight is displayed."'
    - "\"\u53EF\u63A7\u5236Specular\u986F\u793A\u7BC4\u570D\u7684Mask\u8CBC\u5716\uFF0C\u63A1\u6A23\u5230\u7684\u503C\u70BA0\u6642\u4E0D\u986F\u793Aspecular
      highlight\u3002\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u304C\u8868\u793A\u3055\u308C\u308B\u9818\u57DF\u3092\u5236\u5FA1\u3059\u308B\u30DE\u30B9\u30AF\u30C6\u30AF\u30B9\u30C1\u30E3\u3002\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3055\u308C\u305F\u5024\u304C0\u306E\u5834\u5408\u3001\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306F\u8868\u793A\u3055\u308C\u307E\u305B\u3093\u3002\""
  - propertyName: _SpecUVCtrl
    translations:
    - '"Select which UV channel to use for sampling the Specular Mask."'
    - "\"\u9078\u64C7\u7528\u65BC\u63A1\u6A23\u93E1\u9762\u906E\u7F69\u8CBC\u5716\u7684UV\u901A\u9053\u3002\""
    - "\"\u30B9\u30DA\u30AD\u30E5\u30E9\u30FC\u30DE\u30B9\u30AF\u306E\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u306B\u4F7F\u7528\u3059\u308BUV\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u9078\u629E\u3057\u307E\u3059\u3002\""
  - propertyName: _SpecularColor
    translations:
    - '"The color of the specular highlight."'
    - "\"\u53CD\u5C04\u5149\u984F\u8272\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u8272\u3002\""
  - propertyName: _SpecularFallOffColor
    translations:
    - '"The gradient color at the point of specular highlight falloff."'
    - "\"\u53CD\u5C04\u5149\u8870\u6E1B\u8655\u7684\u6F38\u5C64\u984F\u8272\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u30D5\u30A9\u30FC\u30EB\u30AA\u30D5\u306E\u30DD\u30A4\u30F3\u30C8\u3067\u306E\u30B0\u30E9\u30C7\u30FC\u30B7\u30E7\u30F3\u30AB\u30E9\u30FC\u3002\""
  - propertyName: _SpecularSize
    translations:
    - '"Controls the size of the specular highlight."'
    - "\"\u63A7\u5236\u93E1\u9762\u53CD\u5C04\u5149\u7684\u5F71\u97FF\u7BC4\u570D\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u30B5\u30A4\u30BA\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _SpecularFalloff
    translations:
    - '"The softness of the specular highlight falloff. The closer to 0, the more
      obvious the specular highlight boundary is; the closer to 1, the softer the
      specular highlight boundary is."'
    - "\"\u53CD\u5C04\u5149\u8870\u6E1B\u7684\u67D4\u548C\u5EA6\uFF0C\u8D8A\u8DA8\u8FD1\u65BC0\u53CD\u5C04\u5149\u908A\u754C\u8D8A\u660E\u986F\uFF0C\u8D8A\u8DA8\u8FD1\u65BC1\u53CD\u5C04\u5149\u7684\u908A\u754C\u8D8A\u67D4\u548C\u3002\""
    - "\"\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u6E1B\u8870\u306E\u67D4\u3089\u304B\u3055\u30020\u306B\u8FD1\u3044\u307B\u3069\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u5883\u754C\u304C\u306F\u3063\u304D\u308A\u3057\u30011\u306B\u8FD1\u3044\u307B\u3069\u93E1\u9762\u53CD\u5C04\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u5883\u754C\u304C\u67D4\u3089\u304B\u304F\u306A\u308A\u307E\u3059\u3002\""
  - propertyName: _Group4
    translations:
    - 
    - 
    - 
  - propertyName: _RimLightOn
    translations:
    - '"Whether to enable Fresnel rim lighting"'
    - "\"\u662F\u5426\u958B\u555F\u57FA\u65BC\u83F2\u6D85\u8033\u53CD\u5C04\u7684\u8F2A\u5ED3\u5149\""
    - "\"\u30D5\u30EC\u30CD\u30EB\u30EA\u30E0\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u3092\u6709\u52B9\u306B\u3059\u308B\u304B\u3069\u3046\u304B\""
  - propertyName: _RimLightMaskMap
    translations:
    - '"Mask Texture for rim lighting, sample the mask''s R channel, 0 means no rim
      lighting at all for that pixel"'
    - "\"\u8F2A\u5ED3\u5149\u7684\u906E\u7F69\u8CBC\u5716\uFF0C\u63A1\u6A23\u8A72\u8CBC\u5716\u7684R\u901A\u9053\uFF0C\u63A1\u6A230\u4EE3\u8868\u8A72pixel\u4E0D\u6703\u6709\u8F2A\u5ED3\u5149\u3002\""
    - "\"\u30EA\u30E0\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u306E\u30DE\u30B9\u30AF\u30C6\u30AF\u30B9\u30C1\u30E3\u3002\u30DE\u30B9\u30AF\u306ER\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3057\u307E\u3059\u30020\u306F\u3001\u305D\u306E\u30D4\u30AF\u30BB\u30EB\u306B\u30EA\u30E0\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u304C\u307E\u3063\u305F\u304F\u306A\u3044\u3053\u3068\u3092\u610F\u5473\u3057\u307E\u3059\u3002\""
  - propertyName: _RimMaskUVCtrl
    translations:
    - '"Select which UV channel to use for sampling the Rim Mask."'
    - "\"\u9078\u64C7\u7528\u65BC\u63A1\u6A23\u8F2A\u5ED3\u5149\u906E\u7F69\u8CBC\u5716\u7684UV\u901A\u9053\u3002\""
    - "\"\u30EA\u30E0\u30DE\u30B9\u30AF\u306E\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u306B\u4F7F\u7528\u3059\u308BUV\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u9078\u629E\u3057\u307E\u3059\u3002\""
  - propertyName: _RimLightStrength
    translations:
    - '"Controls the strength of the rim light, with a range of 0 to 1."'
    - "\"\u63A7\u5236\u8F2A\u5ED3\u5149\u7684\u5F71\u97FF\u7BC4\u570D\uFF0C\u6578\u503C\u7BC4\u570D0\u52301\u3002\""
    - "\"\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u5F37\u3055\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _RimLightAlign
    translations:
    - 
    - ' with a range of -1 to 1. The default value is 0.'
  - propertyName: When set to 0
    translations:
    - ' the rim light will appear evenly around the edge of the object.'
  - propertyName: When set to 1
    translations:
    - ' the rim light will be in the same direction as the main light source'
    - ' i.e. the edge of the illuminated area.'
  - propertyName: When set to -1
    translations:
    - ' the rim light will be in the opposite direction to the main light source'
    - ' i.e. the edge of the backlit area.""'
    - "\"\u63A7\u5236\u8F2A\u5ED3\u5149\u8207\u4E3B\u5149\u6E90\u7684\u65B9\u5411\u95DC\u4FC2\uFF0C\u6578\u503C\u7BC4\u570D-1\u52301\uFF0C\u9810\u8A2D\u70BA0\uFF0C
      \u8A2D\u5B9A\u70BA0\u6642\uFF0C\u8F2A\u5ED3\u5149\u6703\u5747\u52FB\u5730\u51FA\u73FE\u5728\u7269\u9AD4\u908A\u7DE3\u3002
      \u8A2D\u5B9A\u70BA1\u6642\uFF0C\u8F2A\u5ED3\u5149\u6703\u4EE5\u4E3B\u5149\u6E90\u7684\u7167\u5C04\u65B9\u5411\u540C\u5411\uFF0C\u5373\u9762\u5149\u8655\u7684\u908A\u7DE3\u3002
      \u8A2D\u5B9A\u70BA-1\u6642\uFF0C\u8F2A\u5ED3\u5149\u6703\u4EE5\u4E3B\u5149\u6E90\u7684\u53CD\u65B9\u5411\u540C\u5411\uFF0C\u5373\u80CC\u5149\u8655\u7684\u908A\u7DE3\u3002\""
    - "\"\u30EA\u30E0\u30E9\u30A4\u30C8\u3068\u4E3B\u5149\u6E90\u3068\u306E\u4F4D\u7F6E\u5408\u308F\u305B\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F-1\u301C1\u3067\u3059\u3002\u30C7\u30D5\u30A9\u30EB\u30C8\u5024\u306F0\u3067\u3059\u3002
      0\u306B\u8A2D\u5B9A\u3059\u308B\u3068\u3001\u30EA\u30E0\u30E9\u30A4\u30C8\u306F\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u306E\u7E01\u306E\u5468\u308A\u306B\u5747\u7B49\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002
      1\u306B\u8A2D\u5B9A\u3059\u308B\u3068\u3001\u30EA\u30E0\u30E9\u30A4\u30C8\u306F\u4E3B\u5149\u6E90\u3068\u540C\u3058\u65B9\u5411\u3001\u3064\u307E\u308A\u7167\u3089\u3055\u308C\u305F\u9818\u57DF\u306E\u7E01\u306B\u306A\u308A\u307E\u3059\u3002
      -1\u306B\u8A2D\u5B9A\u3059\u308B\u3068\u3001\u30EA\u30E0\u30E9\u30A4\u30C8\u306F\u4E3B\u5149\u6E90\u3068\u53CD\u5BFE\u306E\u65B9\u5411\u3001\u3064\u307E\u308A\u9006\u5149\u9818\u57DF\u306E\u7E01\u306B\u306A\u308A\u307E\u3059\u3002\""
  - propertyName: _RimLightSmoothness
    translations:
    - '"Controls the softness of the rim light, with a range of 0 to 1."'
    - "\"\u63A7\u5236\u8F2A\u5ED3\u5149\u908A\u7DE3\u7684\u67D4\u548C\u5EA6\uFF0C\u6578\u503C\u7BC4\u570D0\u52301\""
    - "\"\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u7E01\u306E\u67D4\u3089\u304B\u3055\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\u7BC4\u56F2\u306F0\u301C1\u3067\u3059\u3002\""
  - propertyName: _RimLightColor
    translations:
    - '"Controls the color of the rim light"'
    - "\"\u63A7\u5236\u8F2A\u5ED3\u5149\u7684\u984F\u8272\""
    - "\"\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u8272\u3092\u5236\u5FA1\u3057\u307E\u3059\""
  - propertyName: _DepthRimLightOn
    translations:
    - '"Whether to enable rim lighting calculated with the depth buffer."'
    - "\"\u662F\u5426\u958B\u555F\u5229\u7528\u504F\u79FB\u6DF1\u5EA6\u5716\u8A08\u7B97\u51FA\u7684\u8F2A\u5ED3\u5149\""
    - "\"\u6DF1\u5EA6\u30D0\u30C3\u30D5\u30A1\u3092\u4F7F\u7528\u3057\u3066\u8A08\u7B97\u3055\u308C\u305F\u30EA\u30E0\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u3092\u6709\u52B9\u306B\u3059\u308B\u304B\u3069\u3046\u304B\""
  - propertyName: _DepthRimLightColor
    translations:
    - '"The color of the depth-based rim light"'
    - "\"\u6DF1\u5EA6\u504F\u79FB\u8F2A\u5ED3\u5149\u7684\u984F\u8272\""
    - "\"\u6DF1\u5EA6\u30D9\u30FC\u30B9\u306E\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u8272\""
  - propertyName: _DepthRimLightStrength
    translations:
    - '"The strength of the depth-based rim light"'
    - "\"\u6DF1\u5EA6\u504F\u79FB\u8F2A\u5ED3\u5149\u7684\u7BC4\u570D\""
    - "\"\u6DF1\u5EA6\u30D9\u30FC\u30B9\u306E\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u5F37\u3055\""
  - propertyName: _RimLightOverShadow
    translations:
    - 
  - propertyName: When set to 0
    translations:
    - ' the rim light will be covered by the shadow.'
  - propertyName: When set to 1
    translations:
    - ' the rim light will override the shadow (similar to emission).""'
    - "\"\u8F2A\u5ED3\u5149\u84CB\u904E\u9670\u5F71\u8655\u7684\u6DF7\u548C\u7A0B\u5EA6\uFF0C
      \u8A2D\u5B9A\u70BA1\u5247\u8F2A\u5ED3\u5149\u6703\u8986\u84CB\u9670\u5F71(\u985E\u4F3Cemission)\uFF0C
      \u8A2D\u5B9A\u70BA0\u5247\u8F2A\u5ED3\u5149\u6703\u88AB\u9670\u5F71\u8986\u84CB\u3002\""
    - "\"\u5F71\u306B\u5BFE\u3059\u308B\u30EA\u30E0\u30E9\u30A4\u30C8\u306E\u30D6\u30EC\u30F3\u30C9\u5F37\u5EA6\u3002
      0\u306B\u8A2D\u5B9A\u3059\u308B\u3068\u3001\u30EA\u30E0\u30E9\u30A4\u30C8\u306F\u5F71\u3067\u8986\u308F\u308C\u307E\u3059\u3002
      1\u306B\u8A2D\u5B9A\u3059\u308B\u3068\u3001\u30EA\u30E0\u30E9\u30A4\u30C8\u306F\u5F71\u3092\u30AA\u30FC\u30D0\u30FC\u30E9\u30A4\u30C9\u3057\u307E\u3059\uFF08\u30A8\u30DF\u30C3\u30B7\u30E7\u30F3\u306B\u4F3C\u3066\u3044\u307E\u3059\uFF09\u3002\""
  - propertyName: _Group6
    translations:
    - 
    - 
    - 
  - propertyName: _HairHighlightMaskMap
    translations:
    - '"Hair highlight mask. Uses the value of the R channel of the sample texture
      to determine whether the pixel has hair highlights."'
    - "\"\u982D\u9AEE\u9AD8\u5149mask\u8CBC\u5716\u3002\u63A1\u6A23\u8CBC\u5716R\u901A\u9053\u7684\u503C\u4F86\u6C7A\u5B9A\u8A72\u50CF\u7D20\u662F\u5426\u6709\u982D\u9AEE\u9AD8\u5149\u3002\""
    - "\"\u9AEA\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u30DE\u30B9\u30AF\u3002\u30B5\u30F3\u30D7\u30EB\u30C6\u30AF\u30B9\u30C1\u30E3\u306ER\u30C1\u30E3\u30F3\u30CD\u30EB\u306E\u5024\u3092\u4F7F\u7528\u3057\u3066\u3001\u30D4\u30AF\u30BB\u30EB\u306B\u9AEA\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u304C\u3042\u308B\u304B\u3069\u3046\u304B\u3092\u5224\u65AD\u3057\u307E\u3059\u3002\""
  - propertyName: _HairUVCtrl
    translations:
    - '"The UV channel used when sampling the hair highlight mask. The default is
      uv2 (the 3rd uv channel)."'
    - "\"\u63A1\u6A23\u982D\u9AEE\u9AD8\u5149mask\u8CBC\u5716\u6642\u6240\u4F7F\u7528\u7684UV\u901A\u9053\uFF0C
      \u9810\u8A2D\u70BAuv2(\u7B2C\u4E09\u500B\u901A\u9053)\u3002\""
    - "\"\u9AEA\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u30DE\u30B9\u30AF\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3059\u308B\u3068\u304D\u306B\u4F7F\u7528\u3055\u308C\u308BUV\u30C1\u30E3\u30CD\u30EB\u3002\u30C7\u30D5\u30A9\u30EB\u30C8\u306Fuv2\uFF083\u756A\u76EE\u306Euv\u30C1\u30E3\u30CD\u30EB\uFF09\u3067\u3059\u3002\""
  - propertyName: _HairLightColor
    translations:
    - '"Highlight color."'
    - "\"\u9AD8\u5149\u984F\u8272\u3002\""
    - "\"\u30CF\u30A4\u30E9\u30A4\u30C8\u30AB\u30E9\u30FC\u3002\""
  - propertyName: _HairLightFresnelMaskPower
    translations:
    - '"The Fresnel mask power of the viewing direction of the hair highlight. The
      smaller the value, the more the highlight will be restricted into grazing angle."'
    - "\"\u57FA\u65BC\u89C0\u5BDF\u65B9\u5411\u7684\u83F2\u6D85\u8033\u53CD\u5C04\u906E\u7F69\uFF0C\u6578\u503C\u8D8A\u5C0F\uFF0C\u9AD8\u5149\u6703\u8D8A\u9650\u5236\u5728\u7269\u9AD4\u8207\u89C0\u5BDF\u65B9\u5411\u7684\u908A\u7DE3\u624D\u986F\u793A\u3002\""
    - "\"\u9AEA\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u8996\u7DDA\u65B9\u5411\u306E\u30D5\u30EC\u30CD\u30EB\u30DE\u30B9\u30AF\u5F37\u5EA6\u3002\u5024\u304C\u5C0F\u3055\u3044\u307B\u3069\u3001\u30CF\u30A4\u30E9\u30A4\u30C8\u306F\u30B0\u30EC\u30FC\u30B8\u30F3\u30B0\u89D2\u5EA6\u306B\u5236\u9650\u3055\u308C\u307E\u3059\u3002\""
  - propertyName: _HairLightStrength
    translations:
    - '"Highlight Strength"'
    - "\"\u9AD8\u5149\u5F37\u5EA6\uFF0C\u5F37\u5EA6\u70BA0\u4E0D\u986F\u793A\u70BA1\u5247\u662F\u5B8C\u5168\u4F9D\u7167\u63A1\u6A23mask\u7684\u503C\u3002\""
    - "\"\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u5F37\u5EA6\u3002\u5F37\u5EA6\u306F\u30010\u304C\u8868\u793A\u3055\u308C\u305A\u30011\u304C\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3055\u308C\u305F\u30DE\u30B9\u30AF\u5024\u306B\u5B8C\u5168\u306B\u5F93\u3046\u3053\u3068\u3092\u793A\u3057\u307E\u3059\u3002\""
  - propertyName: _HairLightCameraRollInfluence
    translations:
    - '"Controls the amount of offset when the highlight is rotated according to
      the Roll (vertical) direction of the camera."'
    - "\"\u63A7\u5236\u9AD8\u5149\u6839\u64DA\u76F8\u6A5F\u7684Roll(\u5782\u76F4)\u65B9\u5411\u64FA\u52D5\u6642\uFF0C\u504F\u79FB\u7684\u7A0B\u5EA6\""
    - "\"\u30CF\u30A4\u30E9\u30A4\u30C8\u304C\u30AB\u30E1\u30E9\u306E\u30ED\u30FC\u30EB\uFF08\u5782\u76F4\uFF09\u65B9\u5411\u306B\u5F93\u3063\u3066\u56DE\u8EE2\u3057\u305F\u3068\u304D\u306E\u30AA\u30D5\u30BB\u30C3\u30C8\u306E\u91CF\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _HairUVSideCut
    translations:
    - '"Controls the amount of additional culling from the left and right sides (the
      x-value of uv) of the highlight from the specified UV channel."'
    - "\"\u63A7\u5236\u9AD8\u5149\u5F9E\u6307\u5B9AUV\u901A\u9053\u5DE6\u53F3\u5169\u5074
      (uv\u7684x\u503C) \u984D\u5916\u5254\u9664\u7684\u7A0B\u5EA6\u3002\""
    - "\"\u6307\u5B9A\u3055\u308C\u305FUV\u30C1\u30E3\u30CD\u30EB\u304B\u3089\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u5DE6\u53F3\uFF08uv\u306Ex\u5024\uFF09\u304B\u3089\u306E\u8FFD\u52A0\u306E\u5254\u9664\u306E\u91CF\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _GroupMatCap
    translations:
    - 
    - 
    - 
  - propertyName: _MatCapReflectionMap
    translations:
    - '"MatCap texture."'
    - "\"MatCap\u8CBC\u5716\u3002\""
    - "\"MatCap\u30C6\u30AF\u30B9\u30C1\u30E3\u3002\""
  - propertyName: _MatCapReflectionMaskMap
    translations:
    - '"Mask texture for MatCap reflection. The R channel controls the reflection
      area."'
    - "\"MatCap\u53CD\u5C04\u7684\u906E\u7F69\u8CBC\u5716\uFF0CR\u901A\u9053\u63A7\u5236\u53CD\u5C04\u7BC4\u570D\u3002\""
    - "\"MatCap\u53CD\u5C04\u7528\u306E\u30DE\u30B9\u30AF\u30C6\u30AF\u30B9\u30C1\u30E3\u3002R\u30C1\u30E3\u30F3\u30CD\u30EB\u304C\u53CD\u5C04\u9818\u57DF\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _MatCapReflectionStrength
    translations:
    - '"MatCap reflection strength."'
    - "\"MatCap\u53CD\u5C04\u7684\u5F37\u5EA6\u3002\""
    - "\"MatCap\u53CD\u5C04\u306E\u5F37\u5EA6\u3002\""
  - propertyName: _MatCapRollStabilize
    translations:
    - '"Restricts whether the MatCap reflection will change along with the vertical
      movement of the view."'
    - "\"\u9650\u5236MatCap\u53CD\u5C04\u662F\u5426\u6703\u96A8\u8457\u89C0\u5BDF\u7684\u5782\u76F4\u65B9\u5411\u7522\u751F\u8B8A\u5316\u3002
      0\u70BA\u4E0D\u9650\u5236\uFF0C1\u5247\u662F\u5B8C\u5168\u4E0D\u6703\u56E0\u70BA\u89C0\u5BDF\u5782\u76F4\u65B9\u5411\u8B8A\u5316\u800C\u504F\u79FB\u3002\""
    - "\"MatCap\u53CD\u5C04\u304C\u30D3\u30E5\u30FC\u306E\u5782\u76F4\u65B9\u5411\u306E\u52D5\u304D\u306B\u4F34\u3063\u3066\u5909\u5316\u3059\u308B\u304B\u3069\u3046\u304B\u3092\u5236\u9650\u3057\u307E\u3059\u3002
      0\u306F\u5236\u9650\u306A\u3057\u30011\u306F\u30D3\u30E5\u30FC\u306E\u5782\u76F4\u65B9\u5411\u306E\u5909\u5316\u306B\u3088\u3063\u3066\u307E\u3063\u305F\u304F\u30AA\u30D5\u30BB\u30C3\u30C8\u3055\u308C\u307E\u305B\u3093\u3002\""
  - propertyName: _Group7
    translations:
    - 
    - 
    - 
  - propertyName: _ReceiveShadows
    translations:
    - '"Whether to receive shadows from the Unity default ShadowMap."'
    - "\"\u662F\u5426\u63A5\u6536\u4F86\u81EAUnity\u9810\u8A2DShadowMap\u7684\u9670\u5F71\u3002\""
    - "\"Unity\u306E\u30C7\u30D5\u30A9\u30EB\u30C8\u306EShadowMap\u304B\u3089\u5F71\u3092\u53D7\u3051\u53D6\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _ReceiveASPShadow
    translations:
    - '"Whether to receive shadow from ASP character shadow."'
    - "\"\u662F\u5426\u63A5\u6536\u4F86\u81EAASP\u7684\u89D2\u8272\u9670\u5F71\u3002\""
    - "\"ASP\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306E\u5F71\u304B\u3089\u5F71\u3092\u53D7\u3051\u53D6\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _ReceiveOffsetedDepthMap
    translations:
    - '"Whether to receive depth offset shadow from ASP material."'
    - "\"\u662F\u5426\u63A5\u6536ASP\u6750\u8CEA\u7684\u6DF1\u5EA6\u504F\u79FB\u9670\u5F71\u3002\""
    - "\"ASP\u30DE\u30C6\u30EA\u30A2\u30EB\u304B\u3089\u6DF1\u5EA6\u30AA\u30D5\u30BB\u30C3\u30C8\u30B7\u30E3\u30C9\u30A6\u3092\u53D7\u3051\u53D6\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _OffsetShadowDistance
    translations:
    - '"The offset distance of the depth offset shadow."'
    - "\"\u6DF1\u5EA6\u504F\u79FB\u9670\u5F71\u7684\u504F\u79FB\u8DDD\u96E2\u3002\""
    - "\"\u6DF1\u5EA6\u30AA\u30D5\u30BB\u30C3\u30C8\u30B7\u30E3\u30C9\u30A6\u306E\u30AA\u30D5\u30BB\u30C3\u30C8\u8DDD\u96E2\u3002\""
  - propertyName: _AdvanceGroup
    translations:
    - 
    - 
    - 
  - propertyName: _Stencil
    translations:
    - '"Stencil ID"'
    - '"Stencil ID"'
    - "\"\u30B9\u30C6\u30F3\u30B7\u30EBID\""
  - propertyName: _StencilComp
    translations:
    - '"Stencil Compare Function"'
    - '"Stencil Compare Function"'
    - "\"\u30B9\u30C6\u30F3\u30B7\u30EB\u6BD4\u8F03\u95A2\u6570\""
  - propertyName: _StencilOp
    translations:
    - '"Stencil Pass Operation"'
    - '"Stencil Pass Operation"'
    - "\"\u30B9\u30C6\u30F3\u30B7\u30EB\u30D1\u30B9\u64CD\u4F5C\""
  - propertyName: _StencilFailOp
    translations:
    - '"Stencil Fail Operation"'
    - '"Stencil Fail Operation"'
    - "\"\u30B9\u30C6\u30F3\u30B7\u30EB\u5931\u6557\u64CD\u4F5C\""
  - propertyName: _OverrideZTest
    translations:
    - '"Whether to override the default ZTest behavior"'
    - '"Whether to override the default ZTest behavior"'
    - "\"\u30C7\u30D5\u30A9\u30EB\u30C8\u306EZTest\u52D5\u4F5C\u3092\u30AA\u30FC\u30D0\u30FC\u30E9\u30A4\u30C9\u3059\u308B\u304B\u3069\u3046\u304B\""
  - propertyName: _ZTest
    translations:
    - '"The overridden ZTest behavior"'
    - '"The overridden ZTest behavior"'
    - "\"\u30AA\u30FC\u30D0\u30FC\u30E9\u30A4\u30C9\u3055\u308C\u305FZTest\u306E\u52D5\u4F5C\""
  - propertyName: _eyeStyleTitle
    translations:
    - '"Eye shader style"'
    - "\"\u773C\u775B\u6E32\u67D3\u98A8\u683C\""
    - "\"\u76EE\u30B7\u30A7\u30FC\u30C0\u30FC\u306E\u63CF\u753B\u30B9\u30BF\u30A4\u30EB\""
  - propertyName: _EnableParallaxEffect
    translations:
    - '"Enable parallax effect. You can adjust Parallax Height to create a concave
      effect after enabling this function."'
    - "\"\u555F\u7528\u8996\u5DEE\u6548\u679C\u3001\u555F\u7528\u5F8C\u53EF\u4EE5\u900F\u904E\u8ABF\u6574Parallax
      Height\u88FD\u9020\u51F9\u9677\u7684\u6548\u679C\""
    - "\"\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u52B9\u679C\u3092\u6709\u52B9\u306B\u3057\u307E\u3059\u3002\u6709\u52B9\u306B\u3057\u305F\u5F8C\u3001\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u9AD8\u3055\u3092\u8ABF\u6574\u3057\u3066\u51F9\u307F\u306E\u52B9\u679C\u3092\u4F5C\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\""
  - propertyName: _PupilMask
    translations:
    - '"Mask of the pupil area, which affects the area and strength of parallax effect.
      It uses R channel to sample the mask value."'
    - "\"\u77B3\u5B54\u7BC4\u570D\u7684\u906E\u7F69\uFF0C\u5F71\u97FF\u8996\u5DEE\u7684\u7BC4\u570D\u8207\u6548\u679C\uFF0C\u63A1\u6A23R\u901A\u9053\uFF0C\u6578\u503C\u8D8A\u63A5\u8FD11\u5247\u6548\u679C\u8D8A\u5F37\u3002\""
    - "\"\u77B3\u5B54\u9818\u57DF\u306E\u30DE\u30B9\u30AF\u3002\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u52B9\u679C\u306E\u7BC4\u56F2\u3068\u5F37\u5EA6\u306B\u5F71\u97FF\u3057\u307E\u3059\u3002R\u30C1\u30E3\u30F3\u30CD\u30EB\u3067\u30DE\u30B9\u30AF\u5024\u3092\u30B5\u30F3\u30D7\u30EA\u30F3\u30B0\u3057\u307E\u3059\u3002\""
  - propertyName: _ParallaxHeight
    translations:
    - '"Parallax effect height"'
    - "\"\u8996\u5DEE\u6548\u679C\u9AD8\u5EA6\""
    - "\"\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u52B9\u679C\u306E\u9AD8\u3055\""
  - propertyName: _eyeStyle
    translations:
    - '"Determines the eye lighting model. Lambert Lighting - Regular Lambert Diffuse
      lighting. Flat Lighting - Flattened lighting, each pixel of the object will
      change uniformly based on the direction of the light source."'
    - "\"\u6C7A\u5B9A\u773C\u775B\u7684\u5149\u7167\u6A21\u578B\uFF0C\u6709Lambert\u8207Flat\u5169\u7A2E\u6A21\u5F0F\""
    - "\"\u76EE\u306E\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u30E2\u30C7\u30EB\u3092\u6C7A\u5B9A\u3057\u307E\u3059\u3002Lambert
      Lighting - \u901A\u5E38\u306ELambert\u30C7\u30A3\u30D5\u30E5\u30FC\u30BA\u7167\u660E\u3002Flat
      Lighting - \u30D5\u30E9\u30C3\u30C8\u7167\u660E\u3001\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u306E\u5404\u30D4\u30AF\u30BB\u30EB\u304C\u5149\u6E90\u306E\u65B9\u5411\u306B\u57FA\u3065\u3044\u3066\u5747\u4E00\u306B\u5909\u5316\u3057\u307E\u3059\u3002\""
  - propertyName: _SelfUnlitAreaColor
    translations:
    - '"When using the Flat Lighting mode, override the darkest color by this property"'
    - "\"\u7576\u555F\u7528Flat Lighting\u6642\u53EF\u9078\u64C7\uFF0C\u63A7\u5236Flat
      lighting\u6642\u80CC\u5149\u6642\u7684\u984F\u8272\u3002\""
    - "\"Flat\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u30E2\u30FC\u30C9\u4F7F\u7528\u6642\u3001\u80CC\u5149\u90E8\u5206\u306E\u6700\u6697\u8272\u3092\u3053\u306E\u30D7\u30ED\u30D1\u30C6\u30A3\u3067\u4E0A\u66F8\u304D\u3057\u307E\u3059\u3002\""
  - propertyName: _LambertShadowColorMode
    translations:
    - '"Controls how the shadow color behaves when receiving shadows in Lambert lighting
      mode."'
    - "\"\u63A7\u5236Lambert\u5149\u7167\u6A21\u5F0F\u4E0B\u63A5\u6536\u9670\u5F71\u6642\u7684\u9670\u5F71\u984F\u8272\u884C\u70BA\u3002\""
    - "\"Lambert\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u30E2\u30FC\u30C9\u3067\u5F71\u3092\u53D7\u3051\u53D6\u308B\u969B\u306E\u5F71\u306E\u8272\u52D5\u4F5C\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\""
  - propertyName: _LambertReceivedShadowColor
    translations:
    - '"Custom color used for received shadows in Lambert lighting mode."'
    - "\"Lambert\u5149\u7167\u6A21\u5F0F\u4E0B\u81EA\u8A02\u7684\u63A5\u6536\u9670\u5F71\u984F\u8272\u3002\""
    - "\"Lambert\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u30E2\u30FC\u30C9\u3067\u306E\u53D7\u4FE1\u3057\u305F\u5F71\u306B\u4F7F\u7528\u3055\u308C\u308B\u30AB\u30B9\u30BF\u30E0\u30AB\u30E9\u30FC\u3002\""
  - propertyName: _UsePupilMask
    translations:
    - '"Whether to use the pupil mask texture to control the reflection area."'
    - "\"\u662F\u5426\u8981\u4F7F\u7528\u77B3\u5B54\u906E\u7F69\u8CBC\u5716\u4F86\u63A7\u5236MatCap\u53CD\u5C04\u7684\u7BC4\u570D\""
    - "\"\u77B3\u5B54\u30DE\u30B9\u30AF\u30C6\u30AF\u30B9\u30C1\u30E3\u3092\u4F7F\u7528\u3057\u3066MatCap\u53CD\u5C04\u9818\u57DF\u3092\u5236\u5FA1\u3059\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _GroupHighlightLayer1
    translations:
    - 
    - 
    - 
  - propertyName: _HighLightAlphaClip
    translations:
    - '"Whether to use Alpha Clip for the Highlight texture."'
    - "\"\u662F\u5426\u5C0D\u773C\u775B\u9AD8\u5149\u8CBC\u5716\u4F7F\u7528\u900F\u660E\u5EA6\u526A\u88C1\u3002\""
    - "\"\u30CF\u30A4\u30E9\u30A4\u30C8\u30C6\u30AF\u30B9\u30C1\u30E3\u306B\u30A2\u30EB\u30D5\u30A1\u30AF\u30EA\u30C3\u30D7\u3092\u4F7F\u7528\u3059\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _HighlightDarken
    translations:
    - '"Whether to attenuate the intensity of the emission intensity based on the
      light direction."'
    - "\"\u662F\u5426\u6839\u64DA\u5149\u7167\u65B9\u5411\u4F86\u6E1B\u5F31\u81EA\u767C\u5149\u7684\u5F37\u5EA6\u3002\""
    - "\"\u5149\u306E\u65B9\u5411\u306B\u57FA\u3065\u3044\u3066\u30A8\u30DF\u30C3\u30B7\u30E7\u30F3\u5F37\u5EA6\u3092\u6E1B\u8870\u3055\u305B\u308B\u304B\u3069\u3046\u304B\u3002\""
  - propertyName: _EyeHighlightMap1
    translations:
    - '"Top Highlight Map"'
    - "\"\u9AD8\u5149\u8CBC\u5716\""
    - "\"\u30C8\u30C3\u30D7\u30CF\u30A4\u30E9\u30A4\u30C8\u30DE\u30C3\u30D7\""
  - propertyName: _EyeHighlightRotateDegree
    translations:
    - '"Rotate Degree Along Half Vector"'
    - "\"\u6839\u64DA\u534A\u5411\u91CF(Half Vector)\u4F86\u65CB\u8F49\u9AD8\u5149\u7684\u6700\u5927\u65CB\u8F49\u89D2\u5EA6\u3002\""
    - "\"\u30CF\u30FC\u30D5\u30D9\u30AF\u30C8\u30EB\u306B\u6CBF\u3063\u305F\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u6700\u5927\u56DE\u8EE2\u89D2\u5EA6\u3002\""
  - propertyName: _EyeHighlightColor
    translations:
    - '"Top Highlight Color Tint"'
    - "\"Highlight Tint\u984F\u8272(HDR)\""
    - "\"\u30C8\u30C3\u30D7\u30CF\u30A4\u30E9\u30A4\u30C8\u306E\u30C6\u30A3\u30F3\u30C8\u30AB\u30E9\u30FC\uFF08HDR\uFF09\""
