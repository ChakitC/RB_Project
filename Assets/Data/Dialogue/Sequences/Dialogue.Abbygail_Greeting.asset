  lines:
  - speakerCharacterId: npc.abbygail
    speakerNameOverride: 
    poseId: 
    text: Hold it. You're going up there with that squad?
    stageChanges: []
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  - speakerCharacterId: role.Player
    speakerNameOverride: 
    poseId: 
    text: That's the plan.
    stageChanges: []
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  - speakerCharacterId: npc.abbygail
    speakerNameOverride: 
    poseId: 
    text: Then take a crate before you go. Second floor is worse than this one.
    stageChanges: []
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  - speakerCharacterId: role.PartySlot2
    speakerNameOverride: 
    poseId: 
    text: How much worse? We're already light on ammo.
    stageChanges:
    - characterId: role.PartySlot2
      slot: 0
      idlePoseId: 
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  - speakerCharacterId: npc.abbygail
    speakerNameOverride: 
    poseId: 
    text: You'll know when the lights go out.
    stageChanges: []
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  - speakerCharacterId: role.Player
    speakerNameOverride: 
    poseId: 
    text: We'll take the crate. Let's move.
    stageChanges: []
    voice: {fileID: 0}
    typewriterCharactersPerSecond: 0
  lightRig: {fileID: 0}
  typewriterCharactersPerSecond: 40
  allowHoldToSkip: 1
  holdToSkipSeconds: 0.75
