    - "\u555F\u7528\u8996\u5DEE\u8CBC\u5716\u6548\u679C"
    - "\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u52B9\u679C\u6709\u52B9"
  - propertyName: _PupilMask
    translations:
    - Pupil Mask
    - "\u77B3\u5B54\u906E\u7F69\u8CBC\u5716"
    - "\u77B3\u5B54\u30DE\u30B9\u30AF"
  - propertyName: _ParallaxHeight
    translations:
    - Parallax Height
    - "\u8996\u5DEE\u6548\u679C\u9AD8\u5EA6"
    - "\u30D1\u30E9\u30E9\u30C3\u30AF\u30B9\u9AD8\u3055"
  - propertyName: _eyeStyle
    translations:
    - Eye Lighting Mode
    - "\u773C\u775B\u5149\u7167\u6A21\u5F0F"
    - "\u76EE\u306E\u30E9\u30A4\u30C6\u30A3\u30F3\u30B0\u30E2\u30FC\u30C9"
  - propertyName: _SelfUnlitAreaColor
    translations:
    - Darkest Flat Color
    - "\u80CC\u5149\u8272"
    - "\u6700\u6697\u30D5\u30E9\u30C3\u30C8\u30AB\u30E9\u30FC"
  - propertyName: _LambertShadowColorMode
    translations:
