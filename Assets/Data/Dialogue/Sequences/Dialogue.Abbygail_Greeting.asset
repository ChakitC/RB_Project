  m_Name: Dialogue.Abbygail_Greeting
  m_EditorClassIdentifier: 
  dialogueId: dlg.abbygail.greeting
  cast:
  - characterId: role.PartySlot1
    slot: 0
    idlePoseId: 
    optional: 1
  - characterId: role.Player
    slot: 1
    idlePoseId: 
    optional: 1
  - characterId: npc.abbygail
