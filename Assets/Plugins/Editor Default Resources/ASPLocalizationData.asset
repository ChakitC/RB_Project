    - "ASP\u30B7\u30E3\u30C9\u30A6\u30DE\u30C3\u30D7\u304B\u3089\u306E\u8FFD\u52A0\u306E\u5F71\u3092\u53D7\u4FE1"
  - propertyName: _ReceiveOffsetedDepthMap
    translations:
