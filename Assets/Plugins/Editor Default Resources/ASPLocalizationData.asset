    - "\u63A5\u6536\u4F86\u81EA\u504F\u79FB\u6DF1\u5EA6\u8CBC\u5716\u7684\u504F\u79FB\u6DF1\u5EA6\u9670\u5F71"
    - "\u30AA\u30D5\u30BB\u30C3\u30C8\u3055\u308C\u305F\u6DF1\u3055\u30DE\u30C3\u30D7\u304B\u3089\u306E\u8FFD\u52A0\u306E\u5F71\u3092\u53D7\u4FE1"
  - propertyName: _OffsetShadowDistance
    translations:
    - Depth Offset Shadow Pixel Distance
    - "\u504F\u79FB\u6DF1\u5EA6\u9670\u5F71\u7684\u504F\u79FB\u8DDD\u96E2"
    - "\u6DF1\u5EA6\u30AA\u30D5\u30BB\u30C3\u30C8\u5F71\u30D4\u30AF\u30BB\u30EB\u8DDD\u96E2"
  - propertyName: _AdvanceGroup
